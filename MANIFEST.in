include README.md
include LICENSE
include MANIFEST.in
recursive-include commands_async/locale *
recursive-include commands_async/static *
recursive-include commands_async/templates *

# The suite ships in the sdist so the distribution can be verified from source.
# It is kept out of the wheel by [tool.setuptools.packages.find] in pyproject.toml.
include runtests.py
recursive-include test_cmdasync *.py
